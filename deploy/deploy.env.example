DEPLOY_HOST=YOUR_SERVER_IP
DEPLOY_PORT=22
DEPLOY_USER=ubuntu
DEPLOY_SSH_KEY=
REMOTE_APP_DIR=/opt/cairn
REMOTE_REPO_DIR=/opt/cairn-repo
REMOTE_GIT_SSH_KEY=/home/ubuntu/.ssh/id_ed25519_gitee
GITEE_REPO_URL=git@gitee.com:YOUR_ACCOUNT/cairn.git
GO_PROXY=https://goproxy.cn,direct
# Optional: deploy one exact full commit SHA. CI should set this to its checked-out commit.
DEPLOY_COMMIT=
